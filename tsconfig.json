{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,

		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"@api/*": ["src/core/api/*"],
			"@types/*": ["src/types/*"],
			"@lib/*": ["src/lib/*"],
			"@components/*": ["src/components/*"],
			"@core/*": ["src/core/*"],
			"@constants/*": ["src/constants/*"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
